{
  "name": "backend",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest",
    "seed": "node seed.js",
    "test:cobertura": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/controllers/analiticaController.js",
      "src/controllers/gastoRecurrenteController.js",
      "src/controllers/metaController.js",
      "src/controllers/misDatosController.js",
      "src/controllers/presupuestoCategoriaController.js",
      "src/services/gastoRecurrenteService.js",
      "src/services/metaService.js",
      "src/models/Evento.js",
      "src/models/GastoRecurrente.js",
      "src/models/Meta.js",
      "src/models/MovimientoMeta.js",
      "src/models/PresupuestoCategoria.js",
      "src/routes/analiticaRoutes.js",
      "src/routes/gastoRecurrenteRoutes.js",
      "src/routes/metaRoutes.js",
      "src/routes/misDatosRoutes.js",
      "src/routes/presupuestoCategoriaRoutes.js"
    ],
    "coverageDirectory": "../docs/cobertura/backend",
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  }
}
